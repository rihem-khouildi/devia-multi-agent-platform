
# ===========================
#  AUTHENTICATION (JWT)
# ===========================
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===========================
#  HUGGING FACE
# ===========================
HF_TOKEN=

# ===========================
#  Groq
# ===========================
GROQ_API_KEY=

# ===========================
#  Mistral
# ===========================
MISTRAL_API_KEY=

# ===========================
#  AZURE AI FOUNDRY (LLM)
# ===========================
AZURE_FOUNDRY_ENABLED=false
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_BASE_URL=
AZURE_FOUNDRY_MODEL=Kimi-K2.6
LLM_AZURE_FOUNDRY_TIMEOUT_SECONDS=120

# ===========================
#  MODÈLES PAR AGENT
# ===========================
MODEL_ADVISOR=Qwen/Qwen2.5-Coder-32B-Instruct
MODEL_DEVELOPER=Qwen/Qwen2.5-Coder-32B-Instruct
MODEL_TESTER=Qwen/Qwen2.5-7B-Instruct
MODEL_REVIEWER=Qwen/Qwen2.5-Coder-32B-Instruct

# ===========================
#  GITHUB (repo de sortie — où le code généré est poussé)
# ===========================
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main
GITHUB_BASE_BRANCH=main

# ===========================
#  JIRA (optionnel)
# ===========================
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TEST

# ===========================
#  PIPELINE
# ===========================
MIN_TEST_COVERAGE=35.0
TARGET_REPO_PATH=./base-spring-project
OUTPUT_DIR=./output/generated
DOCS_DIR=./docs

# ===========================
#  QUOTA / COÛT LLM
# ===========================
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=./output/artifacts/llm_cache
ADVISOR_MAX_DOC_CHARS=6000

# Developer: génération déterministe par défaut (sans LLM)
DEVELOPER_USE_LLM=false
DEVELOPER_ALLOW_LLM_FIX=true

# Tester
TESTER_USE_LLM=true

# Pipeline reprennable
PIPELINE_REUSE_ANALYSIS=true
PIPELINE_REUSE_CODE=false
PIPELINE_REUSE_TESTS=false
